<Window x:Class="Another_WPF_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Another_WPF_App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF9C9C9C" Offset="1"/>
                <GradientStop Color="#FF818181" Offset="0.007"/>
                <GradientStop Color="#FF818181" Offset="0.316"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" Name="lstFonts" Margin="10,10,400,10" ItemsSource="{Binding Text}"/>
        </Grid>

        <TextBox IsReadOnly="True"  Margin="417,10,96,372" Name="ClockTextBox" Text="{Binding Clock}"/>
        <TextBox IsReadOnly="True"  Margin="417,62,96,320" Name="StatusTextBox" Text="{Binding Status}"/>
        <Button Name="Run_button" FontFamily="Arial" Width="100" Margin="33,305,667,88" Background="#FFFDFDFD" Click="Run_button_Click">
            Run
        </Button>
        <Button Name="Download_button" FontFamily="Arial" Width="100" Margin="33,368,667,25" Background="White" Click="Download_button_Click">
            Download
        </Button>
        <Button Name="Fil_button" FontFamily="Arial" Width="100" Margin="163,305,537,88" Background="White" Click="Fil_button_Click">
            Select file
        </Button>

        <StatusBar Name="sbar" 
        VerticalAlignment="Bottom" Background="#FF9C9C9C" Height="34" Margin="148,0,0,28" >


            <ProgressBar Width="623" Height="20" Name="progressBar" />
            <StatusBarItem HorizontalAlignment="Right">
            </StatusBarItem>
        </StatusBar>
        <TextBox x:Name="FilePathTextBox" IsReadOnly="True" Margin="277,305,28,88" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />


        <TextBox Margin="417,217,242,165" Name="WordsTextBox" Text="" TextChanged="WordsTextBox_TextChanged"/>
        <TextBox Margin="563,217,95,165" Name="LettersTextBox" Text="" TextChanged="LettersTextBox_TextChanged"/>
        <TextBox IsReadOnly="True" Margin="417,160,242,222" Name="WordsTextBox_say" Text="How many Words?"/>
        <TextBox IsReadOnly="True" Margin="563,160,96,222" Name="LetterTextBox_say" Text="How many letters?"/>

    </Grid>
</Window>
